# 后端 API 地址（SSR 用，必须配置）
API_BASE_URL=http://localhost:17857
# 后端 API 地址（客户端用，生产由 __env.js 覆盖）
NEXT_PUBLIC_API_BASE_URL=http://localhost:17857

# ── 对着远端后端跑(本地不起后端/数据库)：把上面两行改成下面三行 ──
# 浏览器端请求走本地 Next 代理(next.config.mjs rewrites)转发到远端，避免跨域；SSR 直连远端。
# API_BASE_URL=http://<远端后端地址>
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
# API_PROXY_TARGET=http://<远端后端地址>

# 地推演示账号白名单(逗号分隔)，这些BUYER账号可看到mock订单数据
NEXT_PUBLIC_DEMO_EMAILS=buyer@cscec3b.local
# 商品列表页默认品类code（无品类参数时展示该品类）
NEXT_PUBLIC_DEFAULT_CATEGORY=04.014
